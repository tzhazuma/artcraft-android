+            //
+            // `WindowEvent::Ime(Ime::Commit)` is what egui/eframe insert text from, so forwarding
+            // it here fixes the keyboard at the owner instead of patching the app.
+            InputEvent::TextEvent(state) => {
+                // GameActivity reports the whole editing buffer on every change, not the edit itself,
+                // so it has to be differenced before it can be delivered as events.
+                let window_id = window::WindowId(WindowId);
+                match crate::ime_delta::ime_delta(&self.ime_text_seen, &state.text) {
+                    crate::ime_delta::ImeDelta::Append(added) => {
+                        // winit's IME contract is that a commit is preceded by an empty preedit,
+                        // which clears any composing underline left by the previous event.
+                        callback(
+                            event::Event::WindowEvent {
+                                window_id,
+                                event: event::WindowEvent::Ime(event::Ime::Preedit(
+                                    String::new(),
+                                    None,
+                                )),
+                            },
+                            self.window_target(),
+                        );
+                        callback(
+                            event::Event::WindowEvent {
+                                window_id,
+                                event: event::WindowEvent::Ime(event::Ime::Commit(added)),
+                            },
+                            self.window_target(),
+                        );
+                    },
+                    // The IME deleted through the input connection. winit has no deletion event and
+                    // egui only removes text on a Backspace key press, so one is synthesised per
+                    // removed character -- without this a typo can be typed but never corrected.
+                    crate::ime_delta::ImeDelta::Delete(count) => {
+                        for _ in 0..count {
+                            callback(
+                                event::Event::WindowEvent {
+                                    window_id,
+                                    event: event::WindowEvent::KeyboardInput {
+                                        device_id: event::DeviceId(DeviceId(0)),
+                                        event: event::KeyEvent {
+                                            state: event::ElementState::Pressed,
+                                            logical_key: crate::keyboard::Key::Named(
+                                                crate::keyboard::NamedKey::Backspace,
+                                            ),
+                                            physical_key: crate::keyboard::PhysicalKey::Code(
+                                                crate::keyboard::KeyCode::Backspace,
+                                            ),
+                                            location: crate::keyboard::KeyLocation::Standard,
+                                            repeat: false,
+                                            text: None,
+                                            platform_specific: KeyEventExtra {},
+                                        },
+                                        is_synthetic: true,
+                                    },
+                                },
+                                self.window_target(),
+                            );
+                        }
+                    },
+                    // A replacement in the middle cannot be expressed as an append or a deletion;
+                    // saying nothing keeps the field intact and lets the next edit resynchronise.
+                    crate::ime_delta::ImeDelta::Replace => {},
+                }
+                if let Some(region) = state.compose_region {
+                    // Keep the composing underline in step with the IME's own idea of it; the text
+                    // itself was already delivered above, so this is display only.
+                    let start = region.start.min(state.text.len());
+                    let end = region.end.min(state.text.len());
+                    callback(
+                        event::Event::WindowEvent {
+                            window_id,
+                            event: event::WindowEvent::Ime(event::Ime::Preedit(
+                                state.text[start..end].to_owned(),
+                                Some((0, end - start)),
+                            )),
+                        },
+                        self.window_target(),
+                    );
