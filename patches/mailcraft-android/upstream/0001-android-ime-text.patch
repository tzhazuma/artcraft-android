+            InputEvent::TextEvent(state) => {
+                // GameActivity reports the whole editing buffer on every change, not the edit itself,
+                // so it has to be differenced before it can be delivered as events.
+                let window_id = window::WindowId(WindowId);
+                let delta = crate::ime_delta::ime_delta(&self.ime_text_seen, &state.text);
+                // Info, not Debug: this port's logger is capped at Info, and this line is the only
+                // way to see what the IME actually reports on a device. It fires once per real
+                // change, so it stays quiet while the user reads. `compose` matters because a CJK
+                // keyboard keeps a composing region until the word is chosen.
+                // Only when the buffer actually moved: the IME re-reports the same text when a
+                // composition is committed, and two lines per keystroke is noise nobody reads.
+                if state.text != self.ime_text_seen {
+                    info!(
+                        "ime text: {} -> {} chars, delta={:?}, compose={:?}",
+                        self.ime_text_seen.chars().count(),
+                        state.text.chars().count(),
+                        delta,
+                        state.compose_region,
+                    );
+                }
+                match delta {
+                    crate::ime_delta::ImeDelta::Append(added) => {
