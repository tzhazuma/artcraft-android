@@ -0,0 +1,74 @@
+//! Differencing for Android IME text reports.
+//!
+//! `android_activity` reports the whole editing buffer on every change, never the edit, so the
+//! difference has to be computed before it can be delivered as winit events. This lives outside
+//! `platform_impl::android` so the rules can be exercised on any host, not only on a device.
+
+/// What one `TextEvent` means relative to the text already delivered.
+///
+/// `android_activity` reports the whole editing buffer each time, so the difference is what carries
+/// meaning. Kept as a free function with no Android types so the rules can be tested on the host.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum ImeDelta {
+    Append(String),
+    Delete(usize),
+    /// The edit is not expressible as an append or a tail deletion.
+    Replace,
+}
+
+pub(crate) fn ime_delta(previous: &str, current: &str) -> ImeDelta {
+    if current == previous {
+        return ImeDelta::Replace;
+    }
+    if let Some(added) = current.strip_prefix(previous) {
+        return ImeDelta::Append(added.to_owned());
+    }
+    if let Some(removed) = previous.strip_prefix(current) {
+        return ImeDelta::Delete(removed.chars().count());
+    }
+    ImeDelta::Replace
+}
+
+
+#[cfg(test)]
+mod ime_delta_tests {
+    use super::{ime_delta, ImeDelta};
+
+    /// The event that broke typing: the buffer grows by one character per keystroke and each report
+    /// contains everything typed so far. Only the new tail may be committed.
+    #[test]
+    fn typing_commits_only_the_new_tail() {
+        assert_eq!(ime_delta("", "a"), ImeDelta::Append("a".into()));
+        assert_eq!(ime_delta("a", "ab"), ImeDelta::Append("b".into()));
+        assert_eq!(ime_delta("ab", "abc"), ImeDelta::Append("c".into()));
+        // Without the difference, "abc" would be inserted three times over.
+        assert_eq!(ime_delta("abc", "abcd"), ImeDelta::Append("d".into()));
+    }
+
+    #[test]
+    fn a_whole_word_arrives_at_once() {
+        assert_eq!(ime_delta("", "hello"), ImeDelta::Append("hello".into()));
+    }
+
+    #[test]
+    fn deleting_the_tail_asks_for_that_many_backspaces() {
+        assert_eq!(ime_delta("abc", "ab"), ImeDelta::Delete(1));
+        assert_eq!(ime_delta("abcd", "ab"), ImeDelta::Delete(2));
+        assert_eq!(ime_delta("abc", ""), ImeDelta::Delete(3));
+    }
+
+    /// Counted in characters, not bytes: a deleted emoji is one backspace, not four.
+    #[test]
+    fn deletion_counts_characters_not_bytes() {
+        assert_eq!(ime_delta("a😀", "a"), ImeDelta::Delete(1));
+        assert_eq!(ime_delta("中文", "中"), ImeDelta::Delete(1));
+    }
+
+    /// An edit in the middle cannot be expressed, and guessing would corrupt the field.
+    #[test]
+    fn a_replacement_is_left_alone() {
+        assert_eq!(ime_delta("abc", "axc"), ImeDelta::Replace);
+        assert_eq!(ime_delta("abc", "abc"), ImeDelta::Replace);
+        assert_eq!(ime_delta("abc", "xyz"), ImeDelta::Replace);
+    }
+}
