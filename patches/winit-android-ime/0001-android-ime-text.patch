diff -ruN nb/src/ime_delta.rs nf/src/ime_delta.rs
--- a/src/ime_delta.rs	1970-01-01 08:00:00.000000000 +0800
+++ b/src/ime_delta.rs	2026-11-17 16:29:48.919716651 +0800
@@ -0,0 +1,113 @@
+//! Differencing for Android IME text reports.
+//!
+//! `android_activity` reports the whole editing buffer on every change, never the edit, so the
+//! difference has to be computed before it can be delivered as winit events. This lives outside
+//! `platform_impl::android` so the rules can be exercised on any host, not only on a device.
+
+/// Bumped whenever these rules change, so `patches/winit-android-ime/setup-winit-ime.sh` can tell a
+/// vendored copy that carries the current rules from one left over from an earlier one. Without a
+/// marker the script only looked for the IME arm, and a tree that had that but not the cursor rules
+/// reported itself as up to date.
+pub(crate) const PATCH_REV: u32 = 2;
+
+/// What one `TextEvent` means relative to the text already delivered.
+///
+/// `android_activity` reports the whole editing buffer each time, so the difference is what carries
+/// meaning. Kept as a free function with no Android types so the rules can be tested on the host.
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum ImeDelta {
+    Append(String),
+    Delete(usize),
+    /// The text did not change, only the cursor did: characters, negative meaning left.
+    MoveCursor(isize),
+    /// The edit is not expressible as an append, a tail deletion or a cursor move.
+    Replace,
+}
+
+/// Differences a report against what was already delivered.
+///
+/// The cursor matters as much as the text. A soft keyboard has no arrow keys of its own, so when the
+/// user moves the caret the only evidence is `selection` moving in a report whose `text` did not
+/// change — without that comparison the caret can be put down but never moved, which is the same
+/// class of defect as the missing `TextEvent` arm itself.
+pub(crate) fn ime_delta(
+    previous: &str,
+    previous_cursor: usize,
+    current: &str,
+    current_cursor: usize,
+) -> ImeDelta {
+    if current == previous {
+        return if current_cursor == previous_cursor {
+            ImeDelta::Replace
+        } else {
+            ImeDelta::MoveCursor(current_cursor as isize - previous_cursor as isize)
+        };
+    }
+    if let Some(added) = current.strip_prefix(previous) {
+        return ImeDelta::Append(added.to_owned());
+    }
+    if let Some(removed) = previous.strip_prefix(current) {
+        return ImeDelta::Delete(removed.chars().count());
+    }
+    ImeDelta::Replace
+}
+
+#[cfg(test)]
+mod ime_delta_tests {
+    use super::{ime_delta, ImeDelta};
+
+    /// The event that broke typing: the buffer grows by one character per keystroke and each report
+    /// contains everything typed so far. Only the new tail may be committed.
+    #[test]
+    fn typing_commits_only_the_new_tail() {
+        assert_eq!(ime_delta("", 0, "a", 1), ImeDelta::Append("a".into()));
+        assert_eq!(ime_delta("a", 1, "ab", 2), ImeDelta::Append("b".into()));
+        assert_eq!(ime_delta("ab", 2, "abc", 3), ImeDelta::Append("c".into()));
+        assert_eq!(ime_delta("abc", 3, "abcd", 4), ImeDelta::Append("d".into()));
+    }
+
+    #[test]
+    fn a_whole_word_arrives_at_once() {
+        assert_eq!(ime_delta("", 0, "hello", 5), ImeDelta::Append("hello".into()));
+    }
+
+    #[test]
+    fn deleting_the_tail_asks_for_that_many_backspaces() {
+        assert_eq!(ime_delta("abc", 3, "ab", 2), ImeDelta::Delete(1));
+        assert_eq!(ime_delta("abcd", 4, "ab", 2), ImeDelta::Delete(2));
+        assert_eq!(ime_delta("abc", 3, "", 0), ImeDelta::Delete(3));
+    }
+
+    /// Counted in characters, not bytes: a deleted emoji is one backspace, not four.
+    #[test]
+    fn deletion_counts_characters_not_bytes() {
+        let two = "a\u{1F600}";
+        assert_eq!(ime_delta(two, 2, "a", 1), ImeDelta::Delete(1));
+        assert_eq!(ime_delta("\u{4E2D}\u{6587}", 2, "\u{4E2D}", 1), ImeDelta::Delete(1));
+    }
+
+    /// An edit in the middle cannot be expressed, and guessing would corrupt the field.
+    #[test]
+    fn a_replacement_is_left_alone() {
+        assert_eq!(ime_delta("abc", 3, "axc", 3), ImeDelta::Replace);
+        assert_eq!(ime_delta("abc", 3, "xyz", 3), ImeDelta::Replace);
+    }
+
+    /// A caret move is the only evidence of an arrow key on a soft keyboard: the text is untouched
+    /// and only `selection` moved.
+    #[test]
+    fn a_cursor_move_becomes_a_direction() {
+        assert_eq!(ime_delta("abc", 3, "abc", 2), ImeDelta::MoveCursor(-1));
+        assert_eq!(ime_delta("abc", 1, "abc", 3), ImeDelta::MoveCursor(2));
+        assert_eq!(ime_delta("abc", 0, "abc", 3), ImeDelta::MoveCursor(3));
+        assert_eq!(ime_delta("abc", 2, "abc", 2), ImeDelta::Replace);
+    }
+
+    /// Typing moves the caret too, and that must not also be reported as an arrow press or every
+    /// character typed would be followed by a cursor jump.
+    #[test]
+    fn typing_is_not_also_a_cursor_move() {
+        assert_eq!(ime_delta("ab", 2, "abc", 3), ImeDelta::Append("c".into()));
+        assert_eq!(ime_delta("abc", 3, "ab", 2), ImeDelta::Delete(1));
+    }
+}
