+                // so it has to be differenced before it can be delivered as events.
+                let window_id = window::WindowId(WindowId);
+                // `selection.start` is a byte offset in the IME's own buffer; the tests and the
+                // cursor bookkeeping count characters, so convert before comparing.
+                let cursor = state.text
+                    .get(..state.selection.start.min(state.text.len()))
+                    .map(|prefix| prefix.chars().count())
