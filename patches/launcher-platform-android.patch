+             ("NotoSansSC-Regular.otf", "Noto Sans SC"),
+             ("DroidSansFallbackFull.ttf", "Droid Sans Fallback"),
+             ("DroidSansFallback.ttf", "Droid Sans Fallback"),
+         ] {
+             add(Path::new("/system/fonts").join(file), family);
+         }
+     }
